generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String
  stores   Store[]

  @@map("users")
}

model Store {
  id       String    @id @default(uuid())
  name     String
  ownerId  String
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products Product[]
  sales    Sale[]

  @@index([ownerId])
  @@map("stores")
}

model Product {
  id        String     @id @default(uuid())
  storeId   String
  name      String
  sku       String
  price     Decimal    @db.Decimal(12, 2)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventory Inventory?
  sales     Sale[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@map("products")
}

model Inventory {
  id        String  @id @default(uuid())
  productId String  @unique
  quantity  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model Sale {
  id        String   @id @default(uuid())
  storeId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  soldAt    DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, soldAt])
  @@index([productId, soldAt])
  @@map("sales")
}
